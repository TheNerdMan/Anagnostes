<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Anagnostes.ViewModels"
        xmlns:ctrl="using:Anagnostes.Controls"
        x:Class="Anagnostes.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Anagnostes"
        Width="580" Height="510"
        CanResize="False"
        WindowDecorations="None"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <SolidColorBrush x:Key="WinBg"       Color="#232323"/>
        <SolidColorBrush x:Key="LcdBg"       Color="#0C1400"/>
        <SolidColorBrush x:Key="LcdGreen"    Color="#4CD619"/>
        <SolidColorBrush x:Key="LcdDimGreen" Color="#1E5C00"/>
        <SolidColorBrush x:Key="BorderOuter" Color="#111111"/>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Button.winamp">
            <Setter Property="Background"                   Value="#424242"/>
			<Setter Property="HorizontalContentAlignment"   Value="Center" />
			<Setter Property="VerticalContentAlignment"     Value="Center" />
			<Setter Property="Foreground"                   Value="#CCCCCC"/>
            <Setter Property="FontFamily"                   Value="Consolas,Courier New,monospace"/>
            <Setter Property="FontSize"                     Value="10"/>
            <Setter Property="FontWeight"                   Value="Bold"/>
            <Setter Property="MinWidth"                     Value="36"/>
            <Setter Property="Height"                       Value="22"/>
            <Setter Property="Padding"                      Value="4,0"/>
            <Setter Property="BorderThickness"              Value="2"/>
            <Setter Property="BorderBrush"                  Value="#6A6A6A"/>
            <Setter Property="CornerRadius"                 Value="1"/>
            <Setter Property="Cursor"                       Value="Hand"/>
            <Setter Property="RenderTransform"              Value="none"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08" Easing="QuadraticEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.winamp:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#555555"/>
        </Style>
        <Style Selector="Button.winamp:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A2A2A"/>
        </Style>
        <Style Selector="Button.winamp:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)"/>
        </Style>
        <Style Selector="Button.winamp:focus-visible /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="#4CD619"/>
        </Style>
        <Style Selector="Button.winamp:disabled /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.35"/>
        </Style>

        <Style Selector="Button.transport">
            <Setter Property="Background"                   Value="#383838"/>
            <Setter Property="Foreground"                   Value="#88DD44"/>
			<Setter Property="HorizontalContentAlignment"   Value="Center" />
			<Setter Property="VerticalContentAlignment"     Value="Center" />
            <Setter Property="FontFamily"                   Value="Consolas,Courier New,monospace"/>
            <Setter Property="FontSize"                     Value="13"/>
            <Setter Property="FontWeight"                   Value="Bold"/>
            <Setter Property="Width"                        Value="46"/>
            <Setter Property="Height"                       Value="26"/>
            <Setter Property="BorderThickness"              Value="2"/>
            <Setter Property="BorderBrush"                  Value="#6A6A6A"/>
            <Setter Property="Padding"                      Value="0"/>
            <Setter Property="Cursor"                       Value="Hand"/>
            <Setter Property="RenderTransform"              Value="none"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08" Easing="QuadraticEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.transport:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#4A4A4A"/>
        </Style>
        <Style Selector="Button.transport:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#222222"/>
        </Style>
        <Style Selector="Button.transport:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)"/>
        </Style>
        <Style Selector="Button.transport:focus-visible /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="#4CD619"/>
        </Style>
        <Style Selector="Button.transport:disabled /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.35"/>
        </Style>
		<Style Selector="Slider.volume">
			<Setter Property="MinHeight" Value="8"/>
		</Style>
		<Style Selector="Slider.volume Grid#SliderContainer">
			<Setter Property="Margin" Value="0 0 0 10"/>
		</Style>
		<Style Selector="Slider.volume /template/ Thumb">
			<Setter Property="Height" Value="10"/>
			<Setter Property="Width" Value="10"/>
		</Style>
    </Window.Styles>

    <!-- Outer shell -->
    <Border Background="{StaticResource WinBg}"
            BorderBrush="{StaticResource BorderOuter}"
            BorderThickness="2"
            CornerRadius="3">
        <Grid RowDefinitions="20,72,46,34,*,36">

            <!-- Row 0 — Custom title bar -->
            <Border Grid.Row="0"
                    Background="#1A1A1A"
                    PointerPressed="TitleBar_PointerPressed"
                    Cursor="SizeAll">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="6,0">
                        <Ellipse Width="8" Height="8" Fill="#4CD619" Margin="0,0,5,0"/>
                        <TextBlock Text="ANAGNOSTES"
                                   FontFamily="Consolas,Courier New,monospace"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="#4CD619"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="winamp"
                            Width="16" Height="14" Padding="0"
                            Margin="0,0,2,0" FontSize="8"
                            Content="_"
                            ToolTip.Tip="Minimize"
                            AutomationProperties.Name="Minimize"
                            Click="MinimizeButton_Click"/>
                    <Button Grid.Column="2" Classes="winamp"
                            Width="16" Height="14" Padding="0"
                            Margin="0,0,4,0" FontSize="8"
                            Background="#8B0000"
                            Content="✕"
                            ToolTip.Tip="Close"
                            AutomationProperties.Name="Close"
                            Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- Row 1 — LCD display panel -->
            <Border Grid.Row="1"
                    Background="{StaticResource LcdBg}"
                    BorderBrush="#0A2000"
                    BorderThickness="3"
                    CornerRadius="2"
                    Margin="4,4,4,2">
                <Grid RowDefinitions="Auto,*,Auto" Margin="8,4">
                    <DockPanel Grid.Row="0">
                        <TextBlock x:Name="PlayStateIndicator"
                                   DockPanel.Dock="Left"
                                   Text="■ "
                                   FontFamily="Consolas,Courier New,monospace"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource LcdDimGreen}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ArticleTitle}"
                                   FontFamily="Consolas,Courier New,monospace"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource LcdGreen}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Grid.Row="1"
                               Text="{Binding StatusText}"
                               FontFamily="Consolas,Courier New,monospace"
                               FontSize="10"
                               Foreground="{StaticResource LcdDimGreen}"
                               AutomationProperties.Name="Player status"
                               AutomationProperties.LiveSetting="Polite"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                    <ProgressBar Grid.Row="2"
                                 IsVisible="{Binding IsBusy}"
                                 Value="{Binding DownloadProgress}"
                                 Minimum="0" Maximum="1"
                                 Height="4"
                                 Foreground="#4CD619"
                                 Background="#0A1A00"
                                 Margin="0,2,0,0"/>
                </Grid>
            </Border>

            <!-- Row 2 — Equaliser bars -->
            <Border Grid.Row="2"
                    Background="#0C0C0C"
                    BorderBrush="#1A1A1A"
                    BorderThickness="1"
                    Margin="4,0,4,2">
                <ctrl:EqBarsControl x:Name="EqBars" IsActive="{Binding IsPlaying}"/>
            </Border>

            <!-- Row 3 — URL input row -->
            <Grid Grid.Row="3" ColumnDefinitions="*,6,80"
                  Margin="4,2,4,2">
                <TextBox Grid.Column="0"
                         Text="{Binding Url}"
                         PlaceholderText="Paste article URL here…"
                         FontFamily="Consolas,Courier New,monospace"
                         FontSize="11"
                         Background="#141414"
                         Foreground="#CCCCCC"
                         CaretBrush="#4CD619"
                         BorderBrush="#4A4A4A"
                         BorderThickness="1"
                         Padding="6,3"
                         CornerRadius="1"
                         AutomationProperties.Name="Article URL"
                         AutomationProperties.HelpText="Paste article URL to load its text for speech"
                         VerticalContentAlignment="Center"/>
                <Button  Grid.Column="2"
                         Classes="winamp"
                         Content="▶ LOAD"
                         Command="{Binding FetchCommand}"
                         ToolTip.Tip="Load article from URL"
                         AutomationProperties.Name="Load article"
                         AutomationProperties.HelpText="Fetches article from URL field"
                         MinHeight="32"
						 MinWidth="80"
                         FontSize="10"
                         Background="#2A3A2A"
                         Foreground="#88DD44"/>
            </Grid>

            <!-- Row 4 — Article text display -->
            <Border Grid.Row="4"
                    Background="#0C0C0C"
                    BorderBrush="#3A3A3A"
                    BorderThickness="1"
                    Margin="4,2,4,2">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <TextBox Text="{Binding ArticleText}"
                               FontFamily="Consolas,Courier New,monospace"
                               FontSize="11"
                               Foreground="#BBBBBB"
                               TextWrapping="Wrap"
                               AcceptsReturn="True"
                               AcceptsTab="False"
                               Padding="8,6"/>
                </ScrollViewer>
            </Border>

            <!-- Row 5 — Transport controls -->
            <Border Grid.Row="5"
                    Background="#1A1A1A"
                    BorderBrush="#111111"
                    BorderThickness="0,1,0,0"
                    Padding="4,2">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left"
                                Orientation="Horizontal" Spacing="3"
                                VerticalAlignment="Center">
                        <Button Classes="transport"
                                Content="▶"
                                ToolTip.Tip="Play or resume"
                                AutomationProperties.Name="Play or resume"
                                Command="{Binding PlayCommand}"/>
                        <Button Classes="transport"
                                Content="⏸"
                                ToolTip.Tip="Pause (Play resumes at this sentence)"
                                AutomationProperties.Name="Pause"
                                Command="{Binding PauseCommand}"/>
                        <Button Classes="transport"
                                Content="⏹"
                                ToolTip.Tip="Stop"
                                AutomationProperties.Name="Stop"
                                Command="{Binding StopCommand}"/>
                    </StackPanel>
					<StackPanel DockPanel.Dock="Right"
			                Orientation="Horizontal" Spacing="4"
			                VerticalAlignment="Center"
			                Margin="0,0,4,0">
                        <TextBlock Text="VOL"
                                   FontFamily="Consolas,Courier New,monospace"
                                   FontSize="9"
                                   Foreground="#888888"
                                   VerticalAlignment="Center"/>
                        <Slider Minimum="0" Maximum="1"
								Classes="volume"
                                Value="{Binding Volume}"
                                Width="80"
                                Foreground="#4CD619"
                                AutomationProperties.Name="Volume"
                                AutomationProperties.HelpText="Speech volume"
                                VerticalAlignment="Center"/>
                    </StackPanel>
					<StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal" Spacing="4"
                                VerticalAlignment="Center"
                                Margin="0,0,4,0">
						<Button Classes="winamp"
                                Content="⚙️"
                                ToolTip.Tip="Settings"
                                AutomationProperties.Name="Open settings"
                                Command="{Binding SettingsCommand}"/>
						<TextBlock Text="VOICE"
                                   FontFamily="Consolas,Courier New,monospace"
                                   FontSize="9"
                                   Foreground="#888888"
                                   VerticalAlignment="Center"/>
						<ComboBox ItemsSource="{Binding Voices}"
                                  SelectedItem="{Binding SelectedVoice}"
                                  IsEnabled="{Binding CanChangeVoice}"
                                  Width="120" Height="22"
                                  FontFamily="Consolas,Courier New,monospace"
                                  FontSize="9"
                                  Foreground="#88DD44"
                                  Background="#141414"
                                  BorderBrush="#4A4A4A"
                                  AutomationProperties.Name="Voice"
                                  AutomationProperties.HelpText="Select text-to-speech voice">
							<ComboBox.ItemTemplate>
								<DataTemplate>
									<TextBlock Text="{Binding VoiceName}" />
								</DataTemplate>
							</ComboBox.ItemTemplate>
						</ComboBox>
					</StackPanel>

					<TextBlock Text="{Binding TtsState}"
                               FontFamily="Consolas,Courier New,monospace"
                               FontSize="10"
                               Foreground="{StaticResource LcdDimGreen}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- Settings screen -->
            <Border Grid.RowSpan="6"
                    IsVisible="{Binding IsSettingsOpen}"
                    Background="#232323"
                    BorderBrush="#4CD619"
                    BorderThickness="2"
                    Margin="28">
                <StackPanel Spacing="12" Margin="20">
                    <DockPanel>
                        <TextBlock Text="SETTINGS"
                                   DockPanel.Dock="Left"
                                   FontFamily="Consolas,Courier New,monospace"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="#4CD619"/>
                        <Button Classes="winamp"
                                DockPanel.Dock="Right"
                                Content="CLOSE"
                                AutomationProperties.Name="Close settings"
                                Command="{Binding SettingsCommand}"/>
                    </DockPanel>
                    <TextBlock Text="VOICE"
                               FontFamily="Consolas,Courier New,monospace"
                               FontSize="10" Foreground="#888888"/>
					<ComboBox ItemsSource="{Binding Voices}"
                              SelectedItem="{Binding SelectedVoice}"
                              IsEnabled="{Binding CanChangeVoice}"
                              Width="180" HorizontalAlignment="Left"
                              FontFamily="Consolas,Courier New,monospace"
                              Foreground="#88DD44" Background="#141414"
                              AutomationProperties.Name="Voice"
                              AutomationProperties.HelpText="Select text-to-speech voice">
						<ComboBox.ItemTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding VoiceName}" />
							</DataTemplate>
						</ComboBox.ItemTemplate>
					</ComboBox>
                    <CheckBox IsChecked="{Binding AutoSpeak}"
                              Content="Start speaking after load"
                              FontFamily="Consolas,Courier New,monospace"
                              Foreground="#CCCCCC"
                              AutomationProperties.Name="Start speaking after load"
                              AutomationProperties.HelpText="Automatically starts text-to-speech after an article loads"/>
                    <TextBlock Text="MODEL FOLDER"
                               FontFamily="Consolas,Courier New,monospace"
                               FontSize="10" Foreground="#888888"/>
                    <Grid ColumnDefinitions="*,6,Auto">
                        <TextBox Grid.Column="0"
                                 Text="{Binding ModelFolder}"
                                 FontFamily="Consolas,Courier New,monospace"
                                 FontSize="10"
                                 Background="#141414"
                                 Foreground="#CCCCCC"
                                 CaretBrush="#4CD619"
                                 BorderBrush="#4A4A4A"
                                 BorderThickness="1"
                                 Padding="4,2"
                                 CornerRadius="1"
                                 AutomationProperties.Name="Model folder path"
                                 AutomationProperties.HelpText="Folder where the TTS model file is stored"/>
                        <Button Grid.Column="2"
                                Classes="winamp"
                                Content="RESET"
                                ToolTip.Tip="Reset to default model folder"
                                AutomationProperties.Name="Reset model folder"
                                Command="{Binding ResetModelFolderCommand}"/>
                    </Grid>
                    <TextBlock Text="Changes take effect on next model load."
                               TextWrapping="Wrap"
                               FontFamily="Consolas,Courier New,monospace"
                               FontSize="10" Foreground="#888888"/>
                    <CheckBox IsChecked="{Binding ShareAnonymousLogs}"
                              Content="Share anonymous logs"
                              FontFamily="Consolas,Courier New,monospace"
                              Foreground="#CCCCCC"/>
                    <TextBlock Text="Opt-in only. Current app sends nothing; future diagnostics may use app events and counts, never URLs or article text."
                               TextWrapping="Wrap"
                               FontFamily="Consolas,Courier New,monospace"
                               FontSize="10" Foreground="#888888"/>
                </StackPanel>
            </Border>

        </Grid>
    </Border>

</Window>
