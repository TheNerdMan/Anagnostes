<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Anagnostes.ViewModels"
        xmlns:ctrl="using:Anagnostes.Controls"
        x:Class="Anagnostes.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Anagnostes"
        Width="580" Height="510"
        CanResize="False"
        WindowDecorations="None"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <SolidColorBrush x:Key="WinBg"       Color="#232323"/>
        <SolidColorBrush x:Key="LcdBg"       Color="#0C1400"/>
        <SolidColorBrush x:Key="LcdGreen"    Color="#4CD619"/>
        <SolidColorBrush x:Key="LcdDimGreen" Color="#1E5C00"/>
        <SolidColorBrush x:Key="BorderOuter" Color="#111111"/>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Button.winamp">
            <Setter Property="Background"      Value="#424242"/>
            <Setter Property="Foreground"      Value="#CCCCCC"/>
            <Setter Property="FontFamily"      Value="Consolas,Courier New,monospace"/>
            <Setter Property="FontSize"        Value="10"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="MinWidth"        Value="36"/>
            <Setter Property="Height"          Value="22"/>
            <Setter Property="Padding"         Value="4,0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush"     Value="#6A6A6A"/>
            <Setter Property="CornerRadius"    Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
        <Style Selector="Button.winamp:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#555555"/>
        </Style>
        <Style Selector="Button.winamp:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A2A2A"/>
        </Style>
        <Style Selector="Button.winamp:disabled /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.35"/>
        </Style>

        <Style Selector="Button.transport">
            <Setter Property="Background"      Value="#383838"/>
            <Setter Property="Foreground"      Value="#88DD44"/>
            <Setter Property="FontFamily"      Value="Consolas,Courier New,monospace"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Width"           Value="46"/>
            <Setter Property="Height"          Value="26"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush"     Value="#6A6A6A"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
        <Style Selector="Button.transport:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#4A4A4A"/>
        </Style>
        <Style Selector="Button.transport:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#222222"/>
        </Style>
        <Style Selector="Button.transport:disabled /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.35"/>
        </Style>
    </Window.Styles>

    <!-- Outer shell -->
    <Border Background="{StaticResource WinBg}"
            BorderBrush="{StaticResource BorderOuter}"
            BorderThickness="2"
            CornerRadius="3">
        <Grid RowDefinitions="20,72,46,34,*,36">

            <!-- Row 0 — Custom title bar -->
            <Border Grid.Row="0"
                    Background="#1A1A1A"
                    PointerPressed="TitleBar_PointerPressed"
                    Cursor="SizeAll">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="6,0">
                        <Ellipse Width="8" Height="8" Fill="#4CD619" Margin="0,0,5,0"/>
                        <TextBlock Text="ANAGNOSTES"
                                   FontFamily="Consolas,Courier New,monospace"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="#4CD619"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="winamp"
                            Width="16" Height="14" Padding="0"
                            Margin="0,0,2,0" FontSize="8"
                            Content="_"
                            Click="MinimizeButton_Click"/>
                    <Button Grid.Column="2" Classes="winamp"
                            Width="16" Height="14" Padding="0"
                            Margin="0,0,2,0" FontSize="8"
                            Content="□"
                            Click="MaximizeButton_Click"/>
                    <Button Grid.Column="3" Classes="winamp"
                            Width="16" Height="14" Padding="0"
                            Margin="0,0,4,0" FontSize="8"
                            Background="#8B0000"
                            Content="✕"
                            Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- Row 1 — LCD display panel -->
            <Border Grid.Row="1"
                    Background="{StaticResource LcdBg}"
                    BorderBrush="#0A2000"
                    BorderThickness="3"
                    CornerRadius="2"
                    Margin="4,4,4,2">
                <Grid RowDefinitions="Auto,*,Auto" Margin="8,4">
                    <DockPanel Grid.Row="0">
                        <TextBlock x:Name="PlayStateIndicator"
                                   DockPanel.Dock="Left"
                                   Text="■ "
                                   FontFamily="Consolas,Courier New,monospace"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource LcdDimGreen}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ArticleTitle}"
                                   FontFamily="Consolas,Courier New,monospace"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource LcdGreen}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Grid.Row="1"
                               Text="{Binding StatusText}"
                               FontFamily="Consolas,Courier New,monospace"
                               FontSize="10"
                               Foreground="{StaticResource LcdDimGreen}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                    <ProgressBar Grid.Row="2"
                                 IsVisible="{Binding IsBusy}"
                                 Value="{Binding DownloadProgress}"
                                 Minimum="0" Maximum="1"
                                 Height="4"
                                 Foreground="#4CD619"
                                 Background="#0A1A00"
                                 Margin="0,2,0,0"/>
                </Grid>
            </Border>

            <!-- Row 2 — Equaliser bars -->
            <Border Grid.Row="2"
                    Background="#0C0C0C"
                    BorderBrush="#1A1A1A"
                    BorderThickness="1"
                    Margin="4,0,4,2">
                <ctrl:EqBarsControl x:Name="EqBars" IsActive="{Binding IsPlaying}"/>
            </Border>

            <!-- Row 3 — URL input row -->
            <Grid Grid.Row="3" ColumnDefinitions="*,6,80"
                  Margin="4,2,4,2">
                <TextBox Grid.Column="0"
                         Text="{Binding Url}"
                         PlaceholderText="Paste article URL here…"
                         FontFamily="Consolas,Courier New,monospace"
                         FontSize="11"
                         Background="#141414"
                         Foreground="#CCCCCC"
                         CaretBrush="#4CD619"
                         BorderBrush="#4A4A4A"
                         BorderThickness="1"
                         Padding="6,3"
                         CornerRadius="1"
                         VerticalContentAlignment="Center"/>
                <Button  Grid.Column="2"
                         Classes="winamp"
                         Content="▶ LOAD"
                         Command="{Binding LoadCommand}"
                         Height="26"
                         FontSize="10"
                         Background="#2A3A2A"
                         Foreground="#88DD44"/>
            </Grid>

            <!-- Row 4 — Article text display -->
            <Border Grid.Row="4"
                    Background="#0C0C0C"
                    BorderBrush="#3A3A3A"
                    BorderThickness="1"
                    Margin="4,2,4,2">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding ArticleText}"
                               FontFamily="Consolas,Courier New,monospace"
                               FontSize="11"
                               Foreground="#BBBBBB"
                               TextWrapping="Wrap"
                               Padding="8,6"/>
                </ScrollViewer>
            </Border>

            <!-- Row 5 — Transport controls -->
            <Border Grid.Row="5"
                    Background="#1A1A1A"
                    BorderBrush="#111111"
                    BorderThickness="0,1,0,0"
                    Padding="4,2">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left"
                                Orientation="Horizontal" Spacing="3"
                                VerticalAlignment="Center">
                        <Button Classes="transport"
                                Content="▶"
                                ToolTip.Tip="Play"
                                Command="{Binding PlayCommand}"/>
                        <Button Classes="transport"
                                Content="⏸"
                                ToolTip.Tip="Pause (Play resumes at this sentence)"
                                Command="{Binding PauseCommand}"/>
                        <Button Classes="transport"
                                Content="⏹"
                                ToolTip.Tip="Stop"
                                Command="{Binding StopCommand}"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal" Spacing="4"
                                VerticalAlignment="Center"
                                Margin="0,0,4,0">
                        <Button Classes="winamp"
                                Content="SET"
                                ToolTip.Tip="Settings"
                                Command="{Binding SettingsCommand}"/>
                        <TextBlock Text="VOICE"
                                   FontFamily="Consolas,Courier New,monospace"
                                   FontSize="9"
                                   Foreground="#888888"
                                   VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding Voices}"
                                  SelectedItem="{Binding Voice}"
                                  IsEnabled="{Binding CanChangeVoice}"
                                  Width="100" Height="22"
                                  FontFamily="Consolas,Courier New,monospace"
                                  FontSize="9"
                                  Foreground="#88DD44"
                                  Background="#141414"
                                  BorderBrush="#4A4A4A"/>
                        <TextBlock Text="VOL"
                                   FontFamily="Consolas,Courier New,monospace"
                                   FontSize="9"
                                   Foreground="#888888"
                                   VerticalAlignment="Center"/>
                        <Slider Minimum="0" Maximum="1"
                                Value="{Binding Volume}"
                                Width="80"
                                Foreground="#4CD619"
                                VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding TtsState}"
                               FontFamily="Consolas,Courier New,monospace"
                               FontSize="10"
                               Foreground="{StaticResource LcdDimGreen}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- Settings screen -->
            <Border Grid.RowSpan="6"
                    IsVisible="{Binding IsSettingsOpen}"
                    Background="#232323"
                    BorderBrush="#4CD619"
                    BorderThickness="2"
                    Margin="28">
                <StackPanel Spacing="12" Margin="20">
                    <DockPanel>
                        <TextBlock Text="SETTINGS"
                                   DockPanel.Dock="Left"
                                   FontFamily="Consolas,Courier New,monospace"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="#4CD619"/>
                        <Button Classes="winamp"
                                DockPanel.Dock="Right"
                                Content="CLOSE"
                                Command="{Binding SettingsCommand}"/>
                    </DockPanel>
                    <TextBlock Text="VOICE"
                               FontFamily="Consolas,Courier New,monospace"
                               FontSize="10" Foreground="#888888"/>
                    <ComboBox ItemsSource="{Binding Voices}"
                              SelectedItem="{Binding Voice}"
                              IsEnabled="{Binding CanChangeVoice}"
                              Width="180" HorizontalAlignment="Left"
                              FontFamily="Consolas,Courier New,monospace"
                              Foreground="#88DD44" Background="#141414"/>
                    <CheckBox IsChecked="{Binding ShareAnonymousLogs}"
                              Content="Share anonymous logs"
                              FontFamily="Consolas,Courier New,monospace"
                              Foreground="#CCCCCC"/>
                    <TextBlock Text="Opt-in only. Current app sends nothing; future diagnostics may use app events and counts, never URLs or article text."
                               TextWrapping="Wrap"
                               FontFamily="Consolas,Courier New,monospace"
                               FontSize="10" Foreground="#888888"/>
                </StackPanel>
            </Border>

        </Grid>
    </Border>

</Window>
